{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "6-am",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-18",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": false, "html_handling": "none" },
  "d1_databases": [{ "binding": "DB", "database_name": "6-am", "database_id": "01e06919-8af5-45d7-8f68-c970c6b9a338", "migrations_dir": "worker/migrations" }],
  "triggers": { "crons": ["0 3 * * *"] }
}
