- var title = '6.am — A space for focus'
- var description = '6.am — a calm, open-source productivity ecosystem.'
doctype html
html(lang="en", class="dark")
  include _head.pug
  body
    .site-shell.home-shell
      include _header.pug
      main.home-main
        p.eyebrow 6.AM / INDEX
        h1.home-title Less noise.<br><span>More focus.</span>
        p.home-intro A set of tools for productive work.
        nav.service-list(aria-label="6.am services")
          a.service-card.service-card-active(href=base + "time.html")
            span.service-index 01
            span.service-copy
              strong Time
              small Clock · stopwatch · Pomodoro
            span.service-arrow(aria-hidden="true") ↗
          each item, index in [{name: 'Tasks', description: 'The next module in the ecosystem'}, {name: 'Rituals', description: 'A place for repeatable practices'}]
            article.service-card.service-card-soon(aria-label=item.name + ': coming soon')
              span.service-index= `0${index + 2}`
              span.service-copy
                strong= item.name
                small= item.description
              span.service-status Coming soon
        p.home-hint#home-hint Open source · made for calm work
      include _footer.pug
